# Required — used server-side only, never exposed to the browser.
BOLNA_API_KEY= 

# Optional — enables the AI call-quality verdict, drop-off detection, and
# prompt-fix suggestions on top of the rule-based diagnosis. Anthropic is used
# if both are set; otherwise OpenAI is used if present. Neither is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only relevant when using OPENAI_API_KEY. Defaults to gpt-4o.
OPENAI_MODEL=
